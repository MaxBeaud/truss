# all generated output lives under build/ (setup.sh: bootstrap, unit, dist, docs)
/build/
/compile_commands.json

# self-hosted CLI binary (built by ./setup.sh build)
/truss

# example build scripts compiled in place
/examples/**/truss
/examples/**/build/

# package lockfile churn (phase 5)
truss.lock

# conan's own lockfile next to its conanfile (phase 6)
/examples/conan/conan.lock

# vcpkg manifest generated by truss (phase 6) — kept out so the
# "generate vcpkg.json" path stays exercised
/examples/vcpkg/vcpkg.json
examples/*/build/
examples/imported/prebuilt/*.o
examples/imported/prebuilt/*.a

# staged installs from `./setup.sh install` (default prefix .local)
/.local/

# self-rebuild depfile written next to the self-hosted CLI (any invocation dir)
/truss.d
**/truss.d
