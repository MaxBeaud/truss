# truss — Doxygen reference (./setup.sh docs -> build/docs/html).
# The README is the user guide; the main page mirrors it with links into the
# generated reference. This is the in-depth API + internals documentation.
# Doxygen 1.18 parses the C++20 module files (module;/export module/import :) natively.

PROJECT_NAME           = "truss"
PROJECT_BRIEF          = "Build your C++ using C++ — mate.h API, xmake-class features, samurai backend"
PROJECT_NUMBER         = 1.0.0
OUTPUT_DIRECTORY       = build/docs
OUTPUT_LANGUAGE        = English

# inputs: main page -> public API partition -> truss:impl + the internals
# pages (README.MD stays the GitHub user guide — its markdown anchors don't
# map to doxygen sections; the main page mirrors it with \ref links)
INPUT                  = docs/mainpage.dox src/api.cppm src/impl.cppm \
                         docs/internals.md docs/cross-compilation.md docs/1.0-roadmap.md
FILE_PATTERNS          = *.cppm *.md *.dox
RECURSIVE              = NO

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_ANON_NSPACES   = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_EXTRA_STYLESHEET  =
GENERATE_LATEX         = NO
GENERATE_TAGFILE       = build/docs/truss.tag

WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = NO
QUIET                  = YES

PREDEFINED             =

# source browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCES_RELATION    = YES
